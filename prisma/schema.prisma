// StockX Enterprise Inventory Management System
// Prisma Schema Definition - PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum UnitOfMeasure {
  kg
  Units
  Liters
  Pieces
}

enum ReceiptStatus {
  Draft
  Waiting
  Received
  Done
  Cancelled
}

enum DeliveryStatus {
  Draft
  Picking
  Packed
  Ready
  Shipped
  Done
  Cancelled
}

enum TransferStatus {
  Draft
  Waiting
  InTransit
  Received
  Done
  Cancelled
}

enum AdjustmentReason {
  Damage
  Loss
  Recount
  Correction
  Expired
}

enum AdjustmentStatus {
  Draft
  PendingApproval
  Approved
  Done
  Cancelled
}

enum MovementType {
  RECEIPT
  DELIVERY
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
}

enum ReferenceType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
  CYCLE_COUNT
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password_hash String
  full_name     String
  role          UserRole  @default(WAREHOUSE_STAFF)
  warehouse_id  String?   @db.Uuid
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  warehouse     Warehouse? @relation("WarehouseStaff", fields: [warehouse_id], references: [id])
  managed_wh    Warehouse[] @relation("WarehouseManager")
  created_receipts Receipt[] @relation("ReceiptCreatedBy")
  approved_receipts Receipt[] @relation("ReceiptApprovedBy")
  created_adjustments StockAdjustment[] @relation("AdjustmentCreatedBy")
  approved_adjustments StockAdjustment[] @relation("AdjustmentApprovedBy")
  stock_ledger_entries StockLedger[]
  audit_logs    AuditLog[]

  @@map("users")
}

model Warehouse {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  location    String
  capacity    Int       @default(10000)
  manager_id  String?   @db.Uuid
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  manager     User?     @relation("WarehouseManager", fields: [manager_id], references: [id])
  staff       User[]    @relation("WarehouseStaff")
  locations   Location[]
  stock_levels StockLevel[]
  receipts    Receipt[]
  deliveries  Delivery[]
  transfers_from InternalTransfer[] @relation("TransferOriginWarehouse")
  transfers_to   InternalTransfer[] @relation("TransferDestWarehouse")
  adjustments StockAdjustment[]
  stock_ledgers StockLedger[]

  @@map("warehouses")
}

model Location {
  id            String    @id @default(uuid()) @db.Uuid
  warehouse_id  String    @db.Uuid
  location_code String    // e.g. "WH-A-Z1-R01-S02-B04"
  location_name String
  zone          String    // Zone A, Zone B, etc.
  rack          String    // Rack A-01
  shelf         String    // Shelf A-01-03
  bin           String    // Bin B-02
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  warehouse     Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  stock_levels  StockLevel[]
  transfers_from InternalTransfer[] @relation("TransferOriginLocation")
  transfers_to   InternalTransfer[] @relation("TransferDestLocation")
  adjustments   StockAdjustment[]
  stock_ledgers StockLedger[]

  @@unique([warehouse_id, location_code])
  @@map("locations")
}

model Category {
  id            String    @id @default(uuid()) @db.Uuid
  category_name String    @unique
  description   String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  products      Product[]

  @@map("categories")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  sku              String        @unique
  product_name     String
  category_id      String        @db.Uuid
  description      String?
  unit_of_measure  UnitOfMeasure @default(Units)
  reorder_point    Int           @default(10)
  reorder_quantity Int           @default(50)
  supplier_id      String?       @db.Uuid
  cost_price       Decimal       @db.Decimal(12, 2)
  selling_price    Decimal       @db.Decimal(12, 2)
  barcode          String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  category         Category      @relation(fields: [category_id], references: [id])
  stock_levels     StockLevel[]
  receipt_items    ReceiptItem[]
  delivery_items   DeliveryItem[]
  transfer_items   TransferItem[]
  adjustment_items AdjustmentItem[]
  stock_ledgers    StockLedger[]

  @@map("products")
}

model StockLevel {
  id                 String    @id @default(uuid()) @db.Uuid
  product_id         String    @db.Uuid
  warehouse_id       String    @db.Uuid
  location_id        String    @db.Uuid
  quantity_on_hand   Int       @default(0)
  quantity_reserved  Int       @default(0)
  quantity_available Int       @default(0)
  last_updated       DateTime  @default(now()) @updatedAt

  product            Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse          Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  location           Location  @relation(fields: [location_id], references: [id], onDelete: Cascade)

  @@unique([product_id, warehouse_id, location_id])
  @@map("stock_levels")
}

model Receipt {
  id             String        @id @default(uuid()) @db.Uuid
  receipt_number String        @unique
  supplier       String
  warehouse_id   String        @db.Uuid
  expected_date  DateTime
  notes          String?
  status         ReceiptStatus @default(Draft)
  created_by     String        @db.Uuid
  approved_by    String?       @db.Uuid
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  warehouse      Warehouse     @relation(fields: [warehouse_id], references: [id])
  creator        User          @relation("ReceiptCreatedBy", fields: [created_by], references: [id])
  approver       User?         @relation("ReceiptApprovedBy", fields: [approved_by], references: [id])
  items          ReceiptItem[]

  @@map("receipts")
}

model ReceiptItem {
  id                String    @id @default(uuid()) @db.Uuid
  receipt_id        String    @db.Uuid
  product_id        String    @db.Uuid
  quantity_ordered  Int
  quantity_received Int       @default(0)
  unit_cost         Decimal   @db.Decimal(12, 2)

  receipt           Receipt   @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [product_id], references: [id])

  @@map("receipt_items")
}

model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  delivery_number String         @unique
  customer_name   String
  warehouse_id    String         @db.Uuid
  delivery_date   DateTime
  notes           String?
  status          DeliveryStatus @default(Draft)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  warehouse       Warehouse      @relation(fields: [warehouse_id], references: [id])
  items           DeliveryItem[]

  @@map("deliveries")
}

model DeliveryItem {
  id               String   @id @default(uuid()) @db.Uuid
  delivery_id      String   @db.Uuid
  product_id       String   @db.Uuid
  quantity_ordered Int
  picked           Int      @default(0)
  packed           Int      @default(0)
  shipped          Int      @default(0)
  unit_price       Decimal  @db.Decimal(12, 2)

  delivery         Delivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [product_id], references: [id])

  @@map("delivery_items")
}

model InternalTransfer {
  id                 String         @id @default(uuid()) @db.Uuid
  transfer_number    String         @unique
  from_warehouse_id  String         @db.Uuid
  from_location_id   String         @db.Uuid
  to_warehouse_id    String         @db.Uuid
  to_location_id     String         @db.Uuid
  reason             String
  status             TransferStatus @default(Draft)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  from_warehouse     Warehouse      @relation("TransferOriginWarehouse", fields: [from_warehouse_id], references: [id])
  from_location      Location       @relation("TransferOriginLocation", fields: [from_location_id], references: [id])
  to_warehouse       Warehouse      @relation("TransferDestWarehouse", fields: [to_warehouse_id], references: [id])
  to_location        Location       @relation("TransferDestLocation", fields: [to_location_id], references: [id])
  items              TransferItem[]

  @@map("internal_transfers")
}

model TransferItem {
  id          String           @id @default(uuid()) @db.Uuid
  transfer_id String           @db.Uuid
  product_id  String           @db.Uuid
  quantity    Int

  transfer    InternalTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [product_id], references: [id])

  @@map("transfer_items")
}

model StockAdjustment {
  id                String           @id @default(uuid()) @db.Uuid
  adjustment_number String           @unique
  warehouse_id      String           @db.Uuid
  location_id       String           @db.Uuid
  reason            AdjustmentReason
  status            AdjustmentStatus @default(Draft)
  notes             String?
  created_by        String           @db.Uuid
  approved_by       String?          @db.Uuid
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  warehouse         Warehouse        @relation(fields: [warehouse_id], references: [id])
  location          Location         @relation(fields: [location_id], references: [id])
  creator           User             @relation("AdjustmentCreatedBy", fields: [created_by], references: [id])
  approver          User?            @relation("AdjustmentApprovedBy", fields: [approved_by], references: [id])
  items             AdjustmentItem[]

  @@map("stock_adjustments")
}

model AdjustmentItem {
  id            String          @id @default(uuid()) @db.Uuid
  adjustment_id String          @db.Uuid
  product_id    String          @db.Uuid
  recorded_qty  Int
  physical_qty  Int
  variance      Int
  notes         String?

  adjustment    StockAdjustment @relation(fields: [adjustment_id], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [product_id], references: [id])

  @@map("adjustment_items")
}

model StockLedger {
  id              String        @id @default(uuid()) @db.Uuid
  timestamp       DateTime      @default(now())
  product_id      String        @db.Uuid
  warehouse_id    String        @db.Uuid
  location_id     String?       @db.Uuid
  movement_type   MovementType
  quantity_change Int           // + or -
  balance_after   Int
  reference_type  ReferenceType
  reference_id    String
  user_id         String        @db.Uuid
  notes           String?

  product         Product       @relation(fields: [product_id], references: [id])
  warehouse       Warehouse     @relation(fields: [warehouse_id], references: [id])
  location        Location?     @relation(fields: [location_id], references: [id])
  user            User          @relation(fields: [user_id], references: [id])

  @@map("stock_ledger")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  user_name   String
  action      String
  entity_type String
  entity_id   String?
  old_values  String?
  new_values  String?
  ip_address  String   @default("127.0.0.1")
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

model CompanySettings {
  id                   String   @id @default(uuid()) @db.Uuid
  company_name         String   @default("StockX Corporation")
  address              String   @default("100 North Riverside Plaza, Suite 2100, Chicago, IL 60606")
  tax_id               String   @default("US-EIN-94-3829104")
  currency             String   @default("USD")
  timezone             String   @default("America/Chicago (CST)")
  low_stock_threshold  Int      @default(15)
  auto_reserve_stock   Boolean  @default(true)
  require_po_approval  Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@map("company_settings")
}
